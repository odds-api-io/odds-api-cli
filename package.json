{
  "name": "odds-api-cli",
  "version": "0.1.3",
  "description": "Command-line client for the Odds-API.io sports betting odds API: live and pre-match odds, value bets and arbitrage from 450+ bookmakers in your terminal",
  "keywords": [
    "odds api",
    "sports odds api",
    "betting odds api",
    "odds",
    "sports betting",
    "betting odds",
    "sportsbook",
    "player props",
    "live odds",
    "odds feed",
    "arbitrage",
    "value bets",
    "websocket",
    "typescript",
    "nfl",
    "nba",
    "mlb",
    "nhl",
    "soccer",
    "football",
    "tennis",
    "esports",
    "bet365",
    "draftkings",
    "fanduel",
    "betfair",
    "cli"
  ],
  "author": "Odds-API.io",
  "license": "MIT",
  "homepage": "https://github.com/odds-api-io/odds-api-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odds-api-io/odds-api-cli.git"
  },
  "bugs": {
    "url": "https://github.com/odds-api-io/odds-api-cli/issues"
  },
  "bin": {
    "odds-api": "dist/cli.js"
  },
  "main": "dist/run.js",
  "types": "dist/run.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "odds-api-io": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
